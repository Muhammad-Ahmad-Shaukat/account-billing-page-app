# Shopify: npm run dev supplies credentials and HOST through Shopify CLI.
# For a hosted deployment, set the secret in the host environment.
# Public client ID, app URL and scopes fall back to shopify.app.toml.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=
# SHOPIFY_APP_URL=https://your-app.example.com
# HOST takes precedence over SHOPIFY_APP_URL during CLI development.

# PostgreSQL invoice store
# Also stores OAuth access tokens/sessions in shopify_sessions.
DATABASE_URL=postgresql://postgres:root@localhost:5432/invoice
# Managed production databases should already exist. Local development can create its DB.
# DATABASE_AUTO_CREATE=false
# For a managed PostgreSQL server requiring TLS (also used by Shopify session storage):
# PGSSLMODE=require
# Optional path for npm run sessions:migrate (default: web/database.sqlite)
# SHOPIFY_LEGACY_SESSION_DB=

# ERP ingest authentication
INVOICE_INGEST_SECRET=change-me-to-a-long-random-secret
INVOICE_SHOP_DOMAIN=your-store.myshopify.com

# Optional static company block on generated invoices
INVOICE_COMPANY_NAME=INK QUEST
INVOICE_STREET_ADDRESS1=14617 134 Ave NW
INVOICE_STREET_ADDRESS2=Edmonton, AB T5L 4S9
INVOICE_TELEPHONE=(780) 454-4321
INVOICE_FAX=(780) 452-5405
INVOICE_TAX_REGISTRATION_NO=
INVOICE_LOGO_URL=
