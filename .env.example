# LIVE DEPLOYMENT ? replace every REPLACE value before starting/deploying.
# Put these settings in your hosting provider's environment variables.
# .env is for local processes; Docker does not automatically load this root file.
# Never commit the real .env. Do not use a temporary tunnel as the live app URL.

# Server: let the hosting platform override PORT if it provides one.
NODE_ENV=production
PORT=8081
# Leave BACKEND_PORT and HOST unset on the live host.

# Shopify app credentials ? same app as shopify.app.toml.
# Client ID is public. Client secret comes from this app's Shopify developer dashboard.
SHOPIFY_API_KEY=REPLACE_WITH_SHOPIFY_CLIENT_ID
SHOPIFY_API_SECRET=REPLACE_WITH_SHOPIFY_CLIENT_SECRET
SHOPIFY_APP_URL=https://account-billing-page-app.onrender.com
SCOPES=write_products,write_app_proxy

# Managed PostgreSQL: invoices AND Shopify OAuth tokens/sessions.
# Create the database first. URL-encode special characters in username/password.
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB_NAME?sslmode=require
DATABASE_AUTO_CREATE=false
# Shopify's session adapter also reads PGSSLMODE. Match your database provider's TLS requirements.
# For Render INTERNAL URLs (short dpg-* hostname), use no-verify: encrypted TLS with a self-signed certificate.
# For external URLs, keep trusted-certificate verification as required by your provider.
PGSSLMODE=require

# ERP ingestion: use the same secret in the ERP's X-Invoice-Secret header.
# The real .env contains a generated secret when the previous value was the scaffold placeholder.
INVOICE_INGEST_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_SECRET
INVOICE_SHOP_DOMAIN=your-store.myshopify.com

# Invoice company details; blank optional values are allowed.
INVOICE_COMPANY_NAME=INK QUEST
INVOICE_STREET_ADDRESS1=14617 134 Ave NW
INVOICE_STREET_ADDRESS2=Edmonton, AB T5L 4S9
INVOICE_TELEPHONE=(780) 454-4321
INVOICE_FAX=(780) 452-5405
INVOICE_TAX_REGISTRATION_NO=
INVOICE_LOGO_URL=

# Optional invoice wording (blank uses the app defaults).
INVOICE_RETURNS_CLAUSE=
INVOICE_OVERDUE_CLAUSE=
INVOICE_CLAIMS_CLAUSE=
INVOICE_SURCHARGE_CLAUSE=

# Optional one-time legacy SQLite session migration; not needed for normal deployment.
# SHOPIFY_LEGACY_SESSION_DB=/absolute/path/to/database.sqlite

# Release sequence after filling the values:
# npm run configure     (syncs public URL/client ID/scopes to shopify.app.toml)
# npm run build
# Deploy the backend with these environment variables, then npm run deploy for the extension.
# Docker build: pass --build-arg SHOPIFY_API_KEY=<public-client-id>.
# Docker run: use --env-file .env, or configure the same variables on your host.
# The production backend runs from web: npm run serve --workspace=shopify-app-template-node
# Reopen the Shopify app after deployment to authorize/store a live OAuth session.
